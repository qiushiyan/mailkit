#!/usr/bin/env python3
"""mail-find -- read-only access to mail history, for an agent to consume.

    mail-find search "from:alice has:attachment newer_than:30d"
    mail-find read <message-id>
    mail-find attachments <message-id>
    mail-find fetch <message-id> --all

Read and send are separate commands on purpose: wanting an agent to look
something up in my mail should not also hand it the ability to send as me.
Output is JSON by default so the model gets structure, not scraped text.
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from mailkit.backends import BackendError, get_backend  # noqa: E402
from mailkit.drafts import human_size  # noqa: E402

# Downloads land here rather than the cwd: attachments are someone else's bytes
# and should not silently litter whatever directory an agent happens to be in.
ATTACHMENT_DIR = Path.home() / ".local/state/mailkit/attachments"


def die(msg):
    print(f"mail-find: {msg}", file=sys.stderr)
    sys.exit(1)


def emit(obj, as_json=True):
    if as_json:
        print(json.dumps(obj, indent=2, ensure_ascii=False))
    return obj


def cmd_search(args, backend):
    hits = backend.search(args.query, limit=args.limit)
    if args.json:
        return emit(hits)
    if not hits:
        print("no matches")
        return
    for h in hits:
        print(f"{h['id']}  {h.get('date') or '':<32}")
        print(f"  from: {h.get('from')}")
        print(f"  subj: {h.get('subject')}")
        if h.get("snippet"):
            print(f"  {h['snippet'][:120]}")
        print()


def cmd_read(args, backend):
    want_remote = getattr(args, "fetch_remote", False)
    msg = backend.message(args.message_id, include_remote=want_remote)

    if want_remote:
        out_dir = Path(args.out).expanduser() if getattr(args, "out", None) \
            else ATTACHMENT_DIR / args.message_id / "remote"
        msg["remote_images"] = [
            backend.fetch_remote(url, out_dir) for url in msg.pop("remote_image_urls", [])
        ]

    if args.json:
        return emit(msg)

    for field in ("date", "from", "to", "cc", "subject"):
        if msg.get(field):
            print(f"{field.capitalize():<9} {msg[field]}")
    if msg["attachments"]:
        for a in msg["attachments"]:
            tag = " [inline]" if a.get("inline") else ""
            print(f"{'Attach':<9} {a['name']} ({human_size(a['size'])}){tag}")
    for img in msg.get("remote_images", []):
        if img.get("error"):
            print(f"{'Remote':<9} {img['url'][:70]} -- FAILED: {img['error']}")
            continue
        dims = f"{img['width']}x{img['height']}" if img.get("width") else "?"
        note = "" if img["kind"] == "image" else f"  <- {img['kind']}"
        print(f"{'Remote':<9} {img['path']}  {dims}{note}")
    print()
    print(msg["body"])


def cmd_thread(args, backend):
    msg = backend.message(args.message_id)
    msgs = backend.thread(msg["thread_id"])
    if args.json:
        return emit(msgs)
    for m in msgs:
        marker = ">" if m["id"] == args.message_id else " "
        print(f"{marker} {m['id']}  {m.get('date') or ''}")
        print(f"    from: {m.get('from')}")
        print(f"    subj: {m.get('subject')}")
        if m["attachments"]:
            print(f"    att : {', '.join(a['name'] for a in m['attachments'])}")
        print()


def cmd_context(args, backend):
    from mailkit import context
    result = context.build(backend, args.message_id, window_days=args.window,
                           limit=args.limit, min_score=args.min_score)
    if args.json:
        return emit(result)

    s = result["seed"]
    print(f"seed  {s['id']}  {s.get('date') or ''}")
    print(f"      {s.get('subject')}")
    sig = result["signals"]
    print(f"signals  identifiers={sig['identifiers'] or '-'}  "
          f"domain={sig['domain'] or '-'}  tokens={sig['subject_tokens'] or '-'}")
    for d in result["dropped_as_too_common"]:
        print(f"dropped  {d['reason']} -- {d['hits']} hits, not distinctive")
    if result["below_min_score"]:
        print(f"held back  {result['below_min_score']} weaker match(es); "
              f"--min-score 1 to see them")
    print()
    if not result["related"]:
        print("nothing related found")
        return
    for r in result["related"]:
        print(f"[{r['score']:>2}] {r['id']}  {r.get('date') or ''}")
        print(f"     {(r.get('subject') or '')[:70]}")
        print(f"     from: {r.get('from')}")
        for w in r["why"]:
            print(f"     why : {w}")
        print()


def cmd_attachments(args, backend):
    atts = backend.attachments(args.message_id)
    if args.json:
        return emit(atts)
    if not atts:
        print("no attachments")
        return
    for a in atts:
        tag = "  [inline]" if a.get("inline") else ""
        print(f"{a['name']}  {human_size(a['size'])}  {a['mime_type']}{tag}")


def cmd_fetch(args, backend):
    atts = backend.attachments(args.message_id)
    if not atts:
        die(f"message {args.message_id} has no attachments")

    if args.all:
        wanted = atts
    elif args.attachment:
        wanted = []
        for token in args.attachment:
            match = [a for a in atts if token in (a["name"], a["id"])]
            if not match:
                available = ", ".join(a["name"] for a in atts)
                die(f"no attachment {token!r} on that message; has: {available}")
            wanted.extend(match)
    else:
        die("pick attachments with --attachment NAME (repeatable) or --all")

    out_dir = Path(args.out).expanduser() if args.out else ATTACHMENT_DIR / args.message_id
    out_dir.mkdir(parents=True, exist_ok=True)

    saved = []
    for a in wanted:
        dest = out_dir / a["name"]
        size = backend.fetch_attachment(args.message_id, a["id"], dest)
        saved.append({"name": a["name"], "path": str(dest), "size": size})

    if args.json:
        return emit(saved)
    for s in saved:
        print(f"{s['path']}  ({human_size(s['size'])})")


def main():
    # The global flags are repeated on every subcommand: argparse only accepts
    # them before the subcommand name, and `mail-find search ... --text` is what
    # anyone (model or human) writes first. SUPPRESS keeps an omitted subcommand
    # flag from clobbering the value given before the subcommand.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--account", choices=["gmail", "outlook"],
                        default=argparse.SUPPRESS)
    common.add_argument("--json", dest="json", action="store_true",
                        default=argparse.SUPPRESS, help="JSON output (default)")
    common.add_argument("--text", dest="json", action="store_false",
                        default=argparse.SUPPRESS,
                        help="human-readable output instead of JSON")

    # The real defaults live on the top-level parser only. A subparser that also
    # carried them would copy them back over a value given before the
    # subcommand name, so the inherited copies stay SUPPRESS.
    p = argparse.ArgumentParser(
        prog="mail-find",
        description="Search, read and download attachments from mail history (read-only).")
    p.add_argument("--account", choices=["gmail", "outlook"], default="gmail")
    p.add_argument("--json", dest="json", action="store_true", default=True,
                   help="JSON output (default)")
    p.add_argument("--text", dest="json", action="store_false",
                   help="human-readable output instead of JSON")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("search", parents=[common],
                       help="search mail history in the provider's own query syntax")
    s.add_argument("query")
    s.add_argument("--limit", type=int, default=25)
    s.set_defaults(fn=cmd_search)

    r = sub.add_parser("read", parents=[common],
                       help="full message: headers, body, attachment manifest")
    r.add_argument("message_id")
    r.add_argument("--fetch-remote", action="store_true",
                   help="also download images the body only links to. Doing so "
                        "tells the sender the mail was opened; the payoff is that "
                        "a screenshot someone sent you stops being an unread URL")
    r.add_argument("--out", metavar="DIR", help="destination for downloaded images")
    r.set_defaults(fn=cmd_read)

    t = sub.add_parser("thread", parents=[common],
                       help="every message Gmail grouped with this one (exact)")
    t.add_argument("message_id")
    t.set_defaults(fn=cmd_thread)

    c = sub.add_parser("context", parents=[common],
                       help="messages about the same real-world thing, across "
                            "threads and senders (heuristic; each hit says why)")
    c.add_argument("message_id")
    c.add_argument("--window", type=int, default=30,
                   help="days either side of the seed for the weak signals")
    c.add_argument("--limit", type=int, default=40)
    c.add_argument("--min-score", type=int, default=2,
                   help="drop hits below this confidence (1 admits matches "
                        "resting on a single weak signal)")
    c.set_defaults(fn=cmd_context)

    a = sub.add_parser("attachments", parents=[common],
                       help="list a message's attachments")
    a.add_argument("message_id")
    a.set_defaults(fn=cmd_attachments)

    f = sub.add_parser("fetch", parents=[common],
                       help="download attachments to a local directory")
    f.add_argument("message_id")
    f.add_argument("--attachment", action="append", metavar="NAME",
                   help="attachment name or id (repeatable)")
    f.add_argument("--all", action="store_true", help="download every attachment")
    f.add_argument("--out", metavar="DIR", help="destination directory")
    f.set_defaults(fn=cmd_fetch)

    args = p.parse_args()
    try:
        backend = get_backend(args.account)
        if not backend.account():
            die(f"not authenticated for {args.account} -- see README")
        args.fn(args, backend)
    except BackendError as e:
        die(str(e))


if __name__ == "__main__":
    main()
